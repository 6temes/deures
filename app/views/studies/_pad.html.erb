<%= form_with url: answers_path, id: "answer", class: "pad", data: {
      pad_target: "form",
      action: "submit->pad#submit
               turbo:submit-start->pad#started
               turbo:submit-end->pad#settled
               keydown.0@window->pad#digit
               keydown.1@window->pad#digit
               keydown.2@window->pad#digit
               keydown.3@window->pad#digit
               keydown.4@window->pad#digit
               keydown.5@window->pad#digit
               keydown.6@window->pad#digit
               keydown.7@window->pad#digit
               keydown.8@window->pad#digit
               keydown.9@window->pad#digit
               keydown.backspace@window->pad#backspace
               keydown.enter@window->pad#enter"
    } do %>
  <div
    class="keys"
    data-controller="tick"
    data-tick-src-value="<%= asset_path "key.wav" %>"
    data-action="pointerdown->tick#press"
  >
    <% (1..9).each do |digit| %>
      <button
        type="button"
        class="key"
        data-key="<%= digit %>"
        data-action="pad#digit"
        data-pad-digit-param="<%= digit %>"
      >
        <%= digit %>
      </button>
    <% end %>

    <button
      type="button"
      class="key key-backspace"
      data-key="backspace"
      data-action="pad#backspace"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 5h11a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9L2 12z" />
        <path d="m14.5 9.5-4 5m0-5 4 5" />
      </svg>
    </button>

    <button
      type="button"
      class="key"
      data-key="0"
      data-action="pad#digit"
      data-pad-digit-param="0"
    >
      0
    </button>

    <button
      type="submit"
      class="key key-enter"
      data-key="submit"
      data-pad-target="submit"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 5v7a3 3 0 0 1-3 3H5" />
        <path d="m9 11-4 4 4 4" />
      </svg>
    </button>
  </div>
<% end %>
