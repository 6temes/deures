#!/usr/bin/env ruby
# Serves the rails-hyperdrive MCP tools over stdio, so each agent session spawns its own copy
# instead of needing bin/dev already up on port 3000.

# Stdout carries the MCP protocol, and SemanticLogger binds an appender to whatever $stdout is
# at boot, so one log line would corrupt it. Boot with $stdout pointed at stderr.
protocol = $stdout
$stdout = $stderr

require_relative "../config/environment"
# The transport references a module this file defines, so the order matters.
require "rails/hyperdrive/mcp_server"
require "mcp/server/transports/stdio_transport"

$stdout = protocol
MCP::Server::Transports::StdioTransport.new(Rails::Hyperdrive::McpServer.server).open
