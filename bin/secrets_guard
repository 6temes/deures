#!/usr/bin/env ruby
# The gate that stands between a mistake and a published repository. This one is public, so a
# key committed here is a key disclosed, and `git rm --cached` afterwards does not take it back
# out of the history. Run over what is staged by the pre-commit hook, and over every tracked
# file by bin/ci.
#
# Paths are the rule that matters. What gets committed by mistake is a whole file nobody meant
# to add, not a string inside one someone read. The content patterns below are only the few
# whose shape admits no innocent reading, because a rule that cries wolf is a rule that gets
# bypassed.

FORBIDDEN_PATHS = {
  %r{(\A|/)\.env(\.|\z)} => "an environment file holds the master key and the backup host's credentials",
  %r{\.key\z} => "a key that decrypts the credentials",
  %r{\.pem\z} => "a certificate or private key",
  %r{(\A|/)id_(rsa|dsa|ecdsa|ed25519)\z} => "an SSH private key",
  %r{(\A|/)known_hosts\z} => "the backup host's fingerprint belongs on the server, not in the repository",
  %r{\.sqlite3(-wal|-shm)?\z} => "a database holds what the children answered",
  %r{\A(tmp|log|storage)/} => "generated at runtime, and a log carries whatever the app logged",
  %r{\A\.claude/} => "local agent state, and worktrees under it carry whole copies of the tree",
  %r{(\A|/)Local\.xcconfig\z} => "the household's Team ID, bundle prefix and host live here, and nowhere committed"
}.freeze

FORBIDDEN_CONTENT = {
  /-----BEGIN [A-Z ]*PRIVATE KEY-----/ => "a private key block",
  /AKIA[0-9A-Z]{16}/ => "an AWS access key id",
  /\b(?:ghp|gho|ghs|ghu)_[A-Za-z0-9]{36}\b/ => "a GitHub token",
  /\bgithub_pat_[A-Za-z0-9_]{50,}/ => "a GitHub fine-grained token",
  /\bsk-[A-Za-z0-9\-_]{20,}/ => "an API secret key",
  /\bxox[abopsr]-[A-Za-z0-9-]{10,}/ => "a Slack token",
  /\bAIza[A-Za-z0-9\-_]{35}\b/ => "a Google API key",
  %r{://[^\s/:@]+:[^\s/@]+@} => "credentials inside a URL: pass them out of band"
}.freeze

# Xcode's Signing screen writes the Team ID into the project file without being asked, where
# nothing else would notice it. Scoped to the files Xcode reads, so prose explaining the setting
# is not refused. An empty or $(VARIABLE) value is the committed placeholder and passes.
XCODE_FILES = %r{(\A|/)project\.pbxproj\z|\.xcconfig\z}
XCODE_CONTENT = {
  /\bDEVELOPMENT_TEAM\s*=\s*"?[A-Za-z0-9]{10}"?\s*;?\s*$/ => "a Team ID: it belongs in ios/Config/Local.xcconfig"
}.freeze

SELF = "bin/secrets_guard".freeze

def staged_paths = `git diff --cached --name-only --diff-filter=ACMR -z`.split("\0")
def tracked_paths = `git ls-files -z`.split("\0")

TRACKED = ARGV.include?("--tracked")

paths = TRACKED ? tracked_paths : staged_paths
paths -= [ SELF ]

# The staged run takes its content from the index, not from the working tree, because that is
# where the two can differ: a file staged with a key in it and then edited clean would be read
# clean and the key would go into the commit anyway. Tracked files have no index to disagree with.
def content_of(path)
  if TRACKED
    File.file?(path) ? File.read(path, encoding: Encoding::UTF_8) : nil
  else
    blob = IO.popen([ "git", "show", ":#{path}" ], "rb", &:read)
    $?.success? ? blob.force_encoding(Encoding::UTF_8) : nil
  end
rescue SystemCallError
  nil
end

offenses = []

paths.each do |path|
  # Rails tracks a .keep in each of those directories on purpose, to carry the empty directory.
  next if File.basename(path) == ".keep"

  FORBIDDEN_PATHS.each do |pattern, reason|
    offenses << "#{path}: #{reason}" if path.match?(pattern)
  end
end

paths.each do |path|
  content = content_of path
  next unless content

  rules = path.match?(XCODE_FILES) ? FORBIDDEN_CONTENT.merge(XCODE_CONTENT) : FORBIDDEN_CONTENT
  # scrub, because a binary a path rule missed still has to be read without raising.
  content.scrub("").each_line.with_index(1) do |line, number|
    rules.each do |pattern, reason|
      offenses << "#{path}:#{number}: #{reason}" if line.match?(pattern)
    end
  end
end

if offenses.any?
  warn "This repository is public. Refusing #{offenses.size == 1 ? "one file" : "#{offenses.size} files"}:"
  offenses.each { warn "  #{it}" }
  warn ""
  warn "Take it out of the commit, not out of the working tree: `git restore --staged <path>`."
  warn "If it is genuinely safe, add the path to .gitignore or the rule to bin/secrets_guard, and say why."
  exit 1
end

puts "Secrets: #{paths.size} #{paths.size == 1 ? "file" : "files"} checked, nothing to refuse."
