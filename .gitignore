# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
#   `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Plans and notes are working documents, read as a published page rather than as files in
# the tree. The page is the shared copy; this directory is one machine's scratch.
/docs/

# Ignore all environment files, at any depth: on the server this one holds the master key
# and the backup host's login. The README carries the sample inline rather than as a file,
# because this pattern would ignore that file too.
.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore development files
/.devcontainer

# Ignore every key that decrypts credentials. `/config/*.key` does not reach
# `config/credentials/production.key`, so both lines are needed, and this repository is
# published: a key committed here is a key disclosed to everyone.
/config/*.key
/config/credentials/*.key

# Agent state: a worktree under here is a whole second copy of the tree, and settings,
# transcripts and local commands are one person's rather than the project's. AGENTS.md and
# CLAUDE.md, at the root, are the parts written to be shared.
/.claude/

# Editor and operating-system noise. It usually belongs in a global gitignore; listing it
# here means a clone is quiet without one.
.DS_Store
/.idea/

# One file in here is the project's rather than one person's: which editor extensions to
# install. Everything else under it is a local preference.
/.vscode/*
!/.vscode/extensions.json
/.ruby-lsp/

# A database anywhere, not only the three config/database.yml names: one holds every answer
# the children have ever typed.
*.sqlite3*

# Console history. The console is this app's whole administration surface, and a pairing
# link printed there signs an iPad in as a child with no further check.
.byebug_history
.irb_history
